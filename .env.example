# apps/web reads these through src/server/env.ts. Copy to apps/web/.env.local.
# Development runs without them, except sign-in. Production refuses to start without the first five.

# https://localhost:3000 in development, since Buffer requires HTTPS redirects. Run `pnpm dev:https`.
APP_URL=

# From your Buffer app client. Use the dev client here, never the judging client.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# A Neon dev branch, never production.
DATABASE_URL=

# 32 random bytes in base64: openssl rand -base64 32
SECRET_KEY=

# chrome-extension://<id> of the side panel allowed to call the API.
EXTENSION_ORIGIN=

# info | warn | error
LOG_LEVEL=info
