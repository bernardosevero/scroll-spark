# apps/web reads these through src/server/env.ts. Copy to apps/web/.env.local, where db:migrate
# finds DATABASE_URL too.
# Development runs without them, except sign-in. Production refuses to start without the first six.

# https://localhost:3000 in development, since Buffer requires HTTPS redirects. Run `pnpm dev:https`.
APP_URL=

# From your Buffer app client. Use the dev client here, never the judging client.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# A Neon dev branch, never production.
DATABASE_URL=

# 32 random bytes in base64: openssl rand -base64 32
SECRET_KEY=

# Real analysis costs money, so ask the owner before using it. Set a spend limit on this key.
ANTHROPIC_API_KEY=

# Set to 1 to use sample answers instead of Claude, so you can try the whole app for free. Buffer
# and the database stay real, so use a throwaway channel. Refused on Vercel. See docs/testing.md.
FAKE_CLAUDE=

# The daily health check, which calls real services. Leave both empty until production is live:
# the secret is at least 32 characters (openssl rand -base64 32), and the user ID is the owner's
# row in the users table, created by signing in. See docs/deploy.md.
HEALTH_SECRET=
HEALTH_BUFFER_USER_ID=

# chrome-extension://<id> of the side panel allowed to call the API. It is also the only extension
# the /extension/connect page will hand a sign-in token to. Without it, nothing can be connected.
# An unpacked build gets a machine-specific ID until WXT_EXTENSION_KEY (below) is set.
EXTENSION_ORIGIN=

# apps/extension reads these at build time, from apps/extension/.env.local or the environment.
# The extension has no business logic of its own, so none of these is a secret.
#
# The website and API the build talks to. Leave it empty for https://localhost:3000. A store build
# sets the production origin, with no trailing slash: that site is then also allowed to connect.
# WXT_API_ORIGIN=https://your-production-domain
#
# The PUBLIC key from the Chrome Web Store upload (Package tab). With it, unpacked and store
# builds share one extension ID, and EXTENSION_ORIGIN can name it. Leave it empty until the
# listing exists, and never commit the private key (the .pem) that goes with it.
# WXT_EXTENSION_KEY=

# info | warn | error
LOG_LEVEL=info
